---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import MethodSteps from '../components/MethodSteps.astro';
---

<Layout title="The method" ground="ink" current="method">
  <PageHero slot="hero" label="slow · feel · speak · meet · flow · tend" headline="Connecting <em>heart and sex</em>" />
  <section class="on-ink section method-page" aria-label="The six steps">
    <div class="container">
      <MethodSteps />
    </div>
  </section>

  <section class="on-paper section--quiet" aria-labelledby="journey-one">
    <div class="container split">
      <h2 id="journey-one" class="display-m" data-split>Journey one: <em>the six steps</em></h2>
      <p class="body-l" data-reveal>[COPY TO COME]</p>
    </div>
  </section>

  <section class="on-flesh section--quiet" aria-labelledby="journey-two">
    <div class="container split">
      <h2 id="journey-two" class="display-m" data-split>Journey two: <em>Tend in depth</em></h2>
      <p class="body-l" data-reveal>[COPY TO COME]</p>
    </div>
  </section>
</Layout>
