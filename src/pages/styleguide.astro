---
// Hidden review page: every building block of the site in one place.
// Not in the menu, and kept out of search engines even after launch.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import MethodSteps from '../components/MethodSteps.astro';
import OfferCard from '../components/OfferCard.astro';
import PriceTable from '../components/PriceTable.astro';
import BookingSteps from '../components/BookingSteps.astro';
import Proof from '../components/Proof.astro';
import EventList from '../components/EventList.astro';
import Newsletter from '../components/Newsletter.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import tokens from '../../brand/tokens.json';
import Timeline from '../components/Timeline.astro';
import Doors from '../components/Doors.astro';
import Accordion from '../components/Accordion.astro';
import { couples, oneToOne, euro, tasterFrom, names } from '../data/packages';

const colours = tokens.color.tokens;
const typeStyles = tokens.type.groups.flatMap((g) => g.styles).filter((t) => t.name !== 'nav' && t.name !== 'button' && t.name !== 'label-s');
const typeClass: Record<string, string> = { body: '' };

const packages = [
  { label: `${names.sniff} · ${couples.sniff.hours} hours · ${euro(couples.sniff.price)}`, price: euro(couples.sniff.price) },
  { label: `journey one · ${names.heartAndSex} · ${couples.heartAndSex.hours} hours · ${euro(couples.heartAndSex.price)}`, price: euro(couples.heartAndSex.price) },
  { label: `recommended · ${names.wholeWay} · ${couples.wholeWay.hours} hours · ${euro(couples.wholeWay.price)}`, price: euro(couples.wholeWay.price), recommended: true },
];
const samplePaths: [{ paragraphs: string[] }, { paragraphs: string[] }] = [
  { paragraphs: ['Both paths hold a little of each other. There\'s ceremony in surrender and something feral in every ritual.'] },
  { paragraphs: ['Both paths hold a little of each other. There\'s ceremony in surrender and something feral in every ritual.'] },
];
const sampleSkills = [
  { q: 'Energy.', lead: 'Breath and erotic energy.', a: 'Building arousal, moving it through your whole body, riding it and letting it grow instead of racing to the finish.' },
  { q: 'Pacing.', lead: 'Building and resting, slow and fast, rising and settling.', a: 'Choosing your speed instead of running on one.' },
];
const grounds = ['paper', 'blood', 'ink', 'flesh'] as const;
---

<Layout title="Styleguide" ground="paper" hidden>
  <PageHero
    slot="hero"
    label="hidden · for review · not in the menu"
    headline="The <em>styleguide</em>"
    intro="Every building block of the site, in one place. The menu above and the footer below are the real ones."
  />

  <section class="on-paper section">
    <div class="container">
      <div class="sg-block">
        <div class="sg-head"><span class="label">01 · colour</span><h2 class="display-s">Colours</h2></div>
        <div class="sg-swatches">
          {colours.map((c) => (
            <div class="sg-swatch">
              <div class="sg-swatch__chip" style={`background: var(--${c.name})`}></div>
              <div class="sg-swatch__info">
                <strong>--{c.name}</strong>
                <span class="label">{c.value.toLowerCase()}</span>
                <span class="body-s">{c.usage}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="sg-block">
        <div class="sg-head"><span class="label">02 · type</span><h2 class="display-s">Type</h2></div>
        <div class="sg-type">
          {typeStyles.map((t) => (
            <div>
              <span class="label">.{t.name} · {t.fontSize}</span>
              <p class={typeClass[t.name] ?? t.name}>{t.sample}</p>
            </div>
          ))}
          <div>
            <span class="label">headline + em</span>
            <p class="display-m">Mind-blowing sex <em>can be learned.</em></p>
          </div>
        </div>
      </div>

      <div class="sg-block">
        <div class="sg-head"><span class="label">03 · buttons and links</span><h2 class="display-s">Buttons on every ground</h2></div>
        <div class="sg-grounds">
          {grounds.map((g) => (
            <div class={`on-${g}`}>
              <span class="label">.on-{g}</span>
              <div class="btn-pair">
                <a class="btn btn--solid" href="#">Book a discovery call</a>
                <a class="btn btn--outline" href="#">Come as a couple</a>
              </div>
              <a class="link-arrow" href="#">How the method works</a>
            </div>
          ))}
        </div>
      </div>

      <div class="sg-block">
        <div class="sg-head"><span class="label">04 · photo slots</span><h2 class="display-s">Photo slots (until photos exist)</h2></div>
        <div class="cards">
          <PhotoSlot caption="tone=flesh · duotone, black on flesh pink" alt="Photo slot, duotone black on flesh pink" tone="flesh" class="photo--card" />
          <PhotoSlot caption="tone=blood · duotone, black on blood red" alt="Photo slot, duotone black on blood red" tone="blood" class="photo--card" />
          <PhotoSlot caption="tone=ink · black and white" alt="Photo slot, black and white" tone="ink" class="photo--card" />
        </div>
      </div>
    </div>
  </section>

  <section class="on-ink section" aria-label="Method steps">
    <div class="container">
      <div class="sg-head"><span class="label">05 · method steps</span></div>
      <div class="method-head" style="margin-top: var(--space-5)">
        <h2 class="display-m">Connecting <em>heart and sex</em></h2>
        <a class="link-arrow" href="#">How the method works</a>
      </div>
      <MethodSteps />
    </div>
  </section>

  <section class="on-paper section" aria-label="Offer cards and price table">
    <div class="container">
      <div class="sg-block">
        <div class="sg-head"><span class="label">06 · offer cards</span></div>
        <div class="cards">
          <OfferCard href="1-1" tone="blood" caption="photo: one body in slow light, shoulder" alt="One body in slow light seen from the shoulder" label={`1:1 · taster from ${tasterFrom(oneToOne)}`} title="1:1" line="Just you, your body and me as your guide. In my space in Lisbon, hands-on, at the pace your body can actually take." cta="Explore 1:1" />
          <OfferCard href="couples" tone="flesh" caption="photo: two hands meeting on skin" alt="Two hands meeting on skin" label={`couples · taster from ${tasterFrom(couples)}`} title="Couples" line="A little sniff in four hours, the whole first journey in ten. In Lisbon or I come to you." cta="Explore couples work" />
          <OfferCard href="events/erotic-ritual-art" tone="ink" caption="photo: performers in low light, bodies in motion" alt="Performers moving in low light" label="monthly · lisbon" title="Erotic Ritual Art" line="Performance art, without words. You play the director, we play it out. You just get to watch (and feel things)." cta="About Erotic Ritual Art" />
        </div>
      </div>
      <div class="sg-block">
        <div class="sg-head"><span class="label">07 · price table</span></div>
        <PriceTable packages={packages} />
      </div>
    </div>
  </section>

  <section class="on-blood section" aria-label="Booking steps">
    <div class="container">
      <div class="sg-head"><span class="label">08 · booking steps</span></div>
      <BookingSteps />
      <a class="btn btn--solid" href="#">Start with the intake form</a>
    </div>
  </section>

  <section class="on-paper section" aria-label="Section label">
    <div class="container"><div class="sg-head"><span class="label">09 · quote panel / proof</span></div></div>
  </section>
  <Proof />

  <section class="on-ink section" aria-label="Upcoming events">
    <div class="container">
      <div class="sg-head"><span class="label">10 · upcoming events (no dates yet)</span></div>
      <div style="margin-top: var(--space-5)"><EventList /></div>
    </div>
  </section>

  <section class="on-blood section" aria-label="Newsletter sign-up">
    <div class="container">
      <div class="sg-head"><span class="label">11 · newsletter sign-up</span></div>
      <div style="margin-top: var(--space-5); max-width: 560px"><Newsletter /></div>
    </div>
  </section>

  <section class="on-paper section" aria-label="Timeline">
    <div class="container">
      <div class="sg-head"><span class="label">13 · timeline</span></div>
      <Timeline />
    </div>
  </section>

  <section class="on-blood section" aria-label="Doors">
    <div class="container">
      <div class="sg-head"><span class="label">14 · the deep end doors</span></div>
      <Doors paths={samplePaths} />
    </div>
  </section>

  <section class="on-ink section" aria-label="Accordion">
    <div class="container">
      <div class="sg-head"><span class="label">15 · accordion (steps and skills)</span></div>
      <div style="margin-top: var(--space-5)"><Accordion items={sampleSkills} /></div>
    </div>
  </section>

  <section class="on-paper section" aria-label="Intake form fields">
    <div class="container">
      <div class="sg-block">
        <div class="sg-head"><span class="label">12 · intake form fields</span><h2 class="display-s">Form fields</h2></div>
        <form class="sg-form" onsubmit="return false">
          <div class="field">
            <label for="sg-name">Field label</label>
            <input id="sg-name" type="text" autocomplete="off" />
            <p class="body-s">Help text in body-s, 15px.</p>
          </div>
          <div class="field">
            <label for="sg-email">Email field</label>
            <input id="sg-email" type="email" autocomplete="off" />
          </div>
          <div class="field">
            <label for="sg-select">Choice field</label>
            <select id="sg-select">
              <option>Option one</option>
              <option>Option two</option>
            </select>
          </div>
          <div class="field">
            <span class="label">checkbox</span>
            <label class="check" for="sg-check"><input id="sg-check" type="checkbox" /><span>Checkbox label</span></label>
          </div>
          <div class="field field--wide">
            <label for="sg-text">Long answer</label>
            <textarea id="sg-text"></textarea>
            <p class="body-s">Labels sit above fields in Hanken Grotesk 700. Fields are white, square, 48px tall, with a 2px black border. Focus shows a 3px black outline.</p>
          </div>
          <div class="field--wide"><button class="btn btn--solid" type="submit">Submit button</button></div>
        </form>
      </div>
    </div>
  </section>
</Layout>
