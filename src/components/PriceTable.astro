---
// One outlined box, packages side by side; the recommended one is filled blood red and comes first on phones.
interface Pkg {
  label: string;
  /** Large price, e.g. "€1,190". */
  price: string;
  paragraphs?: string[];
  small?: string;
  recommended?: boolean;
}
interface Props {
  packages: Pkg[];
}
const { packages } = Astro.props;
---

<div class="prices" style={`--cols: ${packages.length}`} data-stagger>
  {packages.map((p) => (
    <div class:list={['pkg', { 'pkg--rec': p.recommended }]}>
      {p.recommended && <span class="pkg__fill" aria-hidden="true" />}
      <span class="label">{p.label}</span>
      <span class="price">{p.price}</span>
      {p.paragraphs?.map((text) => <p class="pkg__text">{text}</p>)}
      {p.small && <p class="body-s pkg__small">{p.small}</p>}
    </div>
  ))}
</div>
