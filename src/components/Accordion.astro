---
// Questions and answers that open one at a time on click. Uses the browser's own <details>,
// so it works with the keyboard and without JavaScript. No icons: an open question turns italic.
interface Item {
  q: string;
  a: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<div class="acc" data-stagger>
  {items.map((item) => (
    <details class="acc__item">
      <summary class="acc__q">
        <span class="acc__text">{item.q}</span>
        <span class="label acc__state" aria-hidden="true"><span class="acc__open">open</span><span class="acc__close">close</span></span>
      </summary>
      <div class="acc__a">
        <p>{item.a}</p>
      </div>
    </details>
  ))}
</div>
