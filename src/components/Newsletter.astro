---
// The sign-up does not send anywhere yet. Marry will connect Mailchimp later.
import { url } from '../lib/url';
---

<form class="signup" data-signup novalidate>
  <div class="field">
    <label for="signup-email">Your email</label>
    <input id="signup-email" name="email" type="email" autocomplete="email" required />
  </div>
  <button class="btn btn--solid" type="submit">Send me the letters</button>
  <p class="body-s signup__small">Unsubscribe anytime. <a class="link-arrow" href={url('privacy')}>Privacy</a></p>
  <p class="body-s signup__status" role="status" aria-live="polite"></p>
</form>
