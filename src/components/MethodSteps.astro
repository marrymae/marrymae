---
const steps = [
  { name: 'Slow', line: "We slow way down. Slower than feels comfortable (that's kind of the point). Slow builds anticipation and anticipation is delicious." },
  { name: 'Feel', line: "You notice what's actually there. The nerves, the longing, the tenderness you've been skipping. Your body has opinions and we listen." },
  { name: 'Speak', line: "You name it. The stuff that's in the way and the hot stuff you've never dared to ask for." },
  { name: 'Meet', line: "You get seen, exactly as you are and you stay. Permission to be soft. Permission to be ferocious. And everything in between and beyond." },
  { name: 'Flow', line: "And then the erotic current usually unleashes on its own. Again, you learn to stay while it gets hot. Ravenous and right here." },
  { name: 'Tend', line: "Practise it until it's yours. Together in the room first, then at home, alone or together, for years." },
];
---

<ol class="steps" data-steps>
  {steps.map((step, i) => (
    <li class="step">
      <span class="step__rule" aria-hidden="true" data-draw></span>
      <span class="label step__num">{String(i + 1).padStart(2, '0')}</span>
      <span class="display-s step__name">{step.name}</span>
      <span class="step__line">{step.line}</span>
    </li>
  ))}
</ol>
