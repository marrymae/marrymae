---
import PhotoSlot from './PhotoSlot.astro';
import { url } from '../lib/url';

interface Props {
  href: string;
  label: string;
  title: string;
  line: string;
  cta: string;
  /** Shot from the shoot list, shown until the photo exists. */
  caption: string;
  alt: string;
  tone: 'blood' | 'flesh' | 'ink';
  src?: string;
}
const { href, label, title, line, cta, caption, alt, tone, src } = Astro.props;
---

<a class="card offer" href={url(href)}>
  <div class="offer__media">
    <PhotoSlot caption={caption} alt={alt} tone={tone} src={src} class="photo--card" />
  </div>
  <div class="card__body">
    <span class="label">{label}</span>
    <span class="display-s offer__title">{title}</span>
    <span>{line}</span>
    <span class="link-arrow">{cta}</span>
  </div>
</a>
