---
import { url } from '../lib/url';
import { upcoming, formatDate } from '../data/events';

interface Props {
  /** The homepage has its own label and headline above the list. */
  showLabel?: boolean;
}
const { showLabel = true } = Astro.props;
const list = upcoming();
---

{list.length > 0 ? (
  <ul class="events" data-stagger>
    {list.map((e) => (
      <li>
        <a class="event" href={e.href ? url(e.href) : url('events')}>
          <span class="label event__date">{formatDate(e.date)}</span>
          <span class="display-s event__title">{e.title}</span>
          <span class="label event__place">{e.place}</span>
          <span class="link-arrow event__arrow" aria-hidden="true"></span>
        </a>
      </li>
    ))}
  </ul>
) : (
  <div class="events events--soon" data-stagger>
    {showLabel && <span class="label">upcoming</span>}
    <p class="body-l">Erotic Ritual Art, performance art without words, opens in Lisbon soon. Dates and tickets land here first.</p>
    <a class="link-arrow" href={url('events/erotic-ritual-art')}>About Erotic Ritual Art</a>
  </div>
)}
