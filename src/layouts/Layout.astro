---
import '../../brand/tokens.css';
import '../styles/site.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Ground colour of the header and hero. */
  ground?: 'blood' | 'ink' | 'paper';
  /** Nav href of the current page, e.g. "couples". */
  current?: string;
  /** Hands-on offer pages and the FAQ are checked by a lawyer before launch. */
  legalReview?: boolean;
  /** Pages that stay out of search engines even after launch, like /styleguide. */
  hidden?: boolean;
  /** Justify body text on desktop, with hyphenation (homepage). */
  justify?: boolean;
}

const { title, description, ground = 'paper', current, legalReview = false, hidden = false, justify = false } = Astro.props;

// Preview: keep search engines out of every page until launch. At Stage 6 set this to false and delete public/robots.txt.
const PREVIEW = true;
const fullTitle = title.includes('Marry Mae') ? title : `${title} · Marry Mae`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {(PREVIEW || hidden) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#DB2A14" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      // Motion is opt-in: only when JS runs and the visitor hasn't asked for reduced motion.
      // If the animation script never starts, the page is shown as plain, still content.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
        setTimeout(() => {
          if (!document.documentElement.classList.contains('motion-ready')) document.documentElement.classList.remove('motion');
        }, 2500);
      }
    </script>
  </head>
  <body class:list={{ 'justify-text': justify }}>
    {legalReview && <Fragment set:html="<!-- LEGAL REVIEW -->" />}
    <a class="skip" href="#main">Skip to content</a>
    <header class={`site-header on-${ground}`} data-ground={ground}>
      <div class="container">
        <Nav current={current} />
        <slot name="hero" />
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/menu';
      import '../scripts/signup';
      import '../scripts/motion';
    </script>
  </body>
</html>
